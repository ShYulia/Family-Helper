# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor folders
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Playwright artifacts
test-results/
playwright-report/
playwright/.cache/
blob-report/

# Household data (recurring lists, purchase history, real site selectors)
# — personal/site-identifying, not architecture. Example files document
# the shape and stay tracked.
/data/*
!/data/recurring-items.example.json
!/data/site-selectors.example.json

# Browser session state (cookies, localStorage) — more sensitive than the
# recurring list, never committed under any circumstance.
auth-state.json
